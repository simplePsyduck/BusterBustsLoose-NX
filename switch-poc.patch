diff --git a/src/switch_platform.c b/src/switch_platform.c
new file mode 100644
index 0000000..406dee2
--- /dev/null
+++ b/src/switch_platform.c
@@ -0,0 +1,73 @@
+// Nintendo Switch (libnx / devkitA64) glue, see switch_platform.h
+#ifdef __SWITCH__
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <switch.h>
+#include <SDL.h>
+#include "switch_platform.h"
+
+void switch_init(void) {
+#ifdef BBL_NXLINK
+  // stdout/stderr go to `nxlink -s` on the PC (build with: make -f Makefile.switch NXLINK=1)
+  socketInitializeDefault();
+  nxlinkStdio();
+#endif
+}
+
+void switch_shutdown(void) {
+#ifdef BBL_NXLINK
+  socketExit();
+#endif
+}
+
+const char* switch_baseDir(int argc, char** argv) {
+  static char dir[512];
+  dir[0] = 0;
+  if(argc > 0 && argv && argv[0] && argv[0][0]) {
+    snprintf(dir, sizeof(dir), "%s", argv[0]);
+    char* slash = strrchr(dir, '/');
+    if(slash) slash[1] = 0; else dir[0] = 0;
+  }
+  // started loose from /switch (or with no usable path): keep our files in their own folder
+  if(!dir[0] || !strcmp(dir, "sdmc:/switch/") || !strcmp(dir, "/switch/") || !strcmp(dir, "sdmc:/") || !strcmp(dir, "/")) {
+    snprintf(dir, sizeof(dir), "%s", SWITCH_APP_DIR);
+  }
+  mkdir(dir, 0755);   // (already there in the normal case)
+  return dir;
+}
+
+void switch_setupPads(void) {
+  // Button order of SDL's Switch joystick driver: A B X Y, L3 R3, L R, ZL ZR,
+  // + -, then D-pad left up right down; axes LX LY RX RY. The face buttons are
+  // mapped by position (SDL "a" = the bottom button, which Nintendo labels B),
+  // which is what config_defaultPad() assumes: SNES B <- bottom, SNES A <- right.
+  // ZL/ZR are digital, so they become the trigger axes the port reads for fast forward.
+  static const char tail[] =
+    "a:b1,b:b0,x:b3,y:b2,"
+    "back:b11,start:b10,"
+    "leftshoulder:b6,rightshoulder:b7,lefttrigger:b8,righttrigger:b9,"
+    "leftstick:b4,rightstick:b5,"
+    "dpup:b13,dpdown:b15,dpleft:b12,dpright:b14,"
+    "leftx:a0,lefty:a1,rightx:a2,righty:a3,";
+  int n = SDL_NumJoysticks();
+  for(int i = 0; i < n; i++) {
+    char guid[64], map[512];
+    SDL_JoystickGetGUIDString(SDL_JoystickGetDeviceGUID(i), guid, sizeof(guid));
+    snprintf(map, sizeof(map), "%s,Nintendo Switch,%s", guid, tail);
+    SDL_GameControllerAddMapping(map);   // (replaces any built-in mapping for the same GUID)
+  }
+}
+
+bool switch_confirmPressed(void) {
+  static PadState pad;
+  static bool ready;
+  if(!ready) {
+    padInitializeDefault(&pad);   // player 1 + handheld
+    ready = true;
+  }
+  padUpdate(&pad);
+  u64 down = padGetButtonsDown(&pad);
+  return (down & (HidNpadButton_A | HidNpadButton_B | HidNpadButton_Plus)) != 0;
+}
+#endif
diff --git a/src/switch_platform.h b/src/switch_platform.h
new file mode 100644
index 0000000..4b42186
--- /dev/null
+++ b/src/switch_platform.h
@@ -0,0 +1,25 @@
+#pragma once
+// Nintendo Switch (libnx / devkitA64) glue. Only built with __SWITCH__; the
+// rest of the port stays plain SDL2 and goes through these few calls.
+#ifdef __SWITCH__
+#include <stdbool.h>
+
+#define SWITCH_APP_DIR "sdmc:/switch/BusterBustsLoose/"
+
+// libnx extras before SDL starts (nxlink stdout when built with NXLINK=1)
+void switch_init(void);
+void switch_shutdown(void);
+
+// Folder for the ROM, bbl.ini and saves, with a trailing '/': the folder the
+// .nro was started from (argv[0]), or SWITCH_APP_DIR when that is /switch itself
+// or unknown. The folder is created if it is missing.
+const char* switch_baseDir(int argc, char** argv);
+
+// Registers the SDL game controller mapping for the console's pads (positional
+// face buttons like the PC defaults: SDL A = bottom button). Safe to call again.
+void switch_setupPads(void);
+
+// True once A, B or + is pressed (read straight from libnx, so it works on the
+// early error screen even if SDL's controller mapping is wrong)
+bool switch_confirmPressed(void);
+#endif
diff --git a/switch/README.md b/switch/README.md
new file mode 100644
index 0000000..fa9d214
--- /dev/null
+++ b/switch/README.md
@@ -0,0 +1,54 @@
+# Nintendo Switch homebrew build (experimental proof of concept)
+
+Runs the same SDL2 frontend and LakeSnes core as the PC/Android ports as a `.nro`
+under Atmosphère (hbmenu). Like the other ports it needs **your own USA ROM** — nothing
+game-related is built into the `.nro`.
+
+## Build
+
+1. Install devkitPro and the Switch packages: `(dkp-)pacman -S switch-dev switch-sdl2`
+   (`DEVKITPRO` must be set, e.g. `/opt/devkitpro`).
+2. From the repo root: `make -f Makefile.switch`  ->  `BusterBustsLoose.nro`
+   (`make -f Makefile.switch NXLINK=1` also sends stdout/stderr to `nxlink -s`).
+
+## Install and run
+
+Copy to the SD card:
+
+    sd:/switch/BusterBustsLoose/BusterBustsLoose.nro
+    sd:/switch/BusterBustsLoose/<your USA ROM>.sfc        (.smc/.swc/.fig also found)
+
+Start it from hbmenu (**title takeover** / full RAM preferred; the Album applet launch works
+but has less memory). Settings (`bbl.ini`), `saves/` and screenshots are written next to the
+`.nro`. If no ROM is found, an on-screen message says where to put it.
+
+Quick test from a PC: `nxlink -s BusterBustsLoose.nro` (build with `NXLINK=1` to see the log).
+
+## Controls (defaults)
+
+Positional like the PC defaults: bottom face button = SNES B, right = SNES A, left = Y,
+top = X; L/R as is; + = Start; **- opens the menu** (it is the SNES Select, which the game
+only uses as a second Start); ZR = fast forward; left stick also drives the D-pad.
+Bindings can be changed in the menu's Gamepad page.
+
+## What differs from the PC/Android build
+
+- Always full screen (handheld 720p / docked 1080p); the display-mode, monitor and window-size
+  menu entries are hidden (`BBL_FIXED_SCREEN`, shared with Android).
+- Default scaling is *Sharp bilinear*, with its CPU pre-scale capped at 2x.
+- No file dialog: the ROM is searched for in the `.nro`'s folder (and `sdmc:/switch/BusterBustsLoose/`).
+- Window + renderer are created before the ROM search so errors can be drawn on screen.
+- Controller mapping for the Switch joystick driver is registered explicitly (`src/switch_platform.c`).
+- The background "stage select" worker thread gets an explicit 1 MiB stack.
+
+## First-boot checklist (not yet verified on hardware)
+
+1. Builds and links against the portlib (check `sdl2-config --libs` output if the link fails).
+2. Launches from hbmenu; ROM found; title screen shows with sound.
+3. Buttons: bottom = jump (SNES B), left = Y, + = Start, - = menu, ZR = fast forward.
+   If A/B or the stick Y axis feel swapped/inverted, adjust the mapping string in `switch_setupPads()`.
+4. Docked vs handheld: the picture should refit when the console is docked/undocked.
+5. Frame rate: watch *Show FPS* (menu -> Video) in a busy widescreen scene. If it is below 60,
+   try Widescreen *Off*, Sprite limit *Original*, Scaling *Smooth*, then consider a CPU boost.
+6. Home button / sleep: the game should pause on focus loss and resume cleanly.
+7. Saves: quick save/load and a save slot survive an exit and restart.
